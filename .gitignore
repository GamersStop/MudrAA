# ==============================================================================
# MudrAA Protocol — Sovereign Monorepo .gitignore
# Covering: Solana/Anchor, Next.js Frontend, FastAPI Backend, Docker, and Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Solana & Anchor Smart Contract Toolchain
# ------------------------------------------------------------------------------
.anchor/
target/
test-ledger/
**/*.so
**/*.dylib

# Solana Wallets & Keypairs (CRITICAL: Never commit private keys)
**/*-keypair.json
**/id.json
*.keypair
*.privkey

# ------------------------------------------------------------------------------
# 2. Node.js & Next.js Frontend
# ------------------------------------------------------------------------------
**/node_modules/
**/.pnp
.pnp.js
**/.yarn/cache
**/.yarn/unplugged

# Next.js build output & cache
**/.next/
**/out/
**/dist/
**/build/

# TypeScript declarations & cache
*.tsbuildinfo
next-env.d.ts

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Python & FastAPI Backend
# ------------------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so
.Python

# Distribution / packaging
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
