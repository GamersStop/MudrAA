# ==============================================================================
# MudrAA Protocol — Frontend Environment Configuration Template
# ==============================================================================

# 1. Solana Network & RPC Gateway
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# 2. Offchain FastAPI Ingestion Service
NEXT_PUBLIC_API_URL=http://localhost:8000

# 3. Judge Evaluation & Test Mode Controller
# Set to "true" to enable frictionless evaluation auto-login for hackathon judges
# Set to "false" to enforce standard production login (manual Phantom/Solflare connection)
NEXT_PUBLIC_TEST_MODE=true

# 4. Evaluation Demo Wallet Public Key (Base58)
# When NEXT_PUBLIC_TEST_MODE=true, this public key is loaded into the test session
# NO PRIVATE KEYS EVER — ONLY PUBLIC ADDRESS
NEXT_PUBLIC_DEMO_WALLET_ADDRESS=HPV1sNFAwGFEcQHTDhxkE9rFPSjuQymX9VuFR6sLtoGr
