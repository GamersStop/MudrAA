# ==============================================================================
# MudrAA Protocol — Frontend Environment Configuration Template
# ==============================================================================

# 1. Solana Network & RPC Gateway
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# 2. Offchain FastAPI Ingestion Service
NEXT_PUBLIC_API_URL=http://localhost:8000

# 3. Judge Evaluation & Test Mode Controller
# Set to "true" to enable frictionless evaluation auto-login for hackathon judges
# Set to "false" to enforce standard production login (manual Phantom/Solflare connection)
NEXT_PUBLIC_TEST_MODE=true

# 4. Evaluation Demo Wallet Public Keys (Base58)
# Persona 1: Admin & Exporter
NEXT_PUBLIC_DEMO_WALLET_ADDRESS=AzHZTAXadh8vBmT9SUQrqq1bKsMUjQaXacArWZZnyiJ8
# Persona 2: Institutional Liquidity Provider / Lender
NEXT_PUBLIC_LP_WALLET_ADDRESS=C3CBRnk4xg9up53McWMNSYFMAYrUctGm2eWdvM4gipvP
# Persona 3: Factory & Global Exporter
NEXT_PUBLIC_EXPORTER_WALLET_ADDRESS=4215yZFmakPLePKXqYVqcBmVJHMK6SLfmJGW8h3UgQfG

# 5. Server-Side Devnet Relayer Keypairs (OPTIONAL - FOR ON-CHAIN BROADCAST)
# Server-only! NEVER prefix with NEXT_PUBLIC_. Ignored by git (.env*.local).
DEMO_RELAYER_PRIVATE_KEY=
LP_RELAYER_PRIVATE_KEY=
EXPORTER_RELAYER_PRIVATE_KEY=
