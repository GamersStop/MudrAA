# ==============================================================================
# MudrAA Protocol — Offchain Relayer Service Environment Template
# ==============================================================================

# 1. Database Connection (PostgreSQL or Async SQLite)
DATABASE_URL=postgresql+asyncpg://mudraa_admin:mudraa_dev_password@localhost:5432/mudraa_trade

# 2. Redis Cache & Job Queue
REDIS_URL=redis://localhost:6379/0

# 3. Server Configuration
PORT=8000
HOST=0.0.0.0

# 4. CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.mudraa.finance

# 5. Solana Network & Program Configuration
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=MudrAA1111111111111111111111111111111111111
